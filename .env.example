# Copy to .env.local for local development; set the same keys in Vercel > Project > Settings > Environment Variables.

# Resend (https://resend.com) API key. Without it the contact form falls back to copy / open-in-email.
RESEND_API_KEY=
# Where contact form messages go.
CONTACT_TO_EMAIL=nayeebrahman@gmail.com
# Sender. onboarding@resend.dev works for testing; use an address on your own verified domain in production.
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
# Public URL used for social preview links.
NEXT_PUBLIC_SITE_URL=https://nayeeb-website.vercel.app
